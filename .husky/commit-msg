#!/usr/bin/env bash
# agent_1 Commit Message Validator
# Enforces Conventional Commits format: type(scope): subject

COMMIT_MSG=$(cat "$1")

PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_-]+\))?: .{1,72}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "================================================"
  echo "  INVALID COMMIT MESSAGE FORMAT"
  echo "================================================"
  echo ""
  echo "  Commit message must follow Conventional Commits:"
  echo "    type(scope): subject"
  echo ""
  echo "  Types: feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert"
  echo "  Scope:  optional, e.g. (core), (api), (desktop)"
  echo "  Subject: imperative, lowercase, <=72 chars, no period"
  echo ""
  echo "  Examples:"
  echo "    feat(core): add streaming response support"
  echo "    fix(desktop): resolve IPC bridge type mismatch"
  echo "    chore(deps): update typescript to v5.4"
  echo ""
  echo "  Your message: \"$COMMIT_MSG\""
  echo ""
  exit 1
fi

exit 0