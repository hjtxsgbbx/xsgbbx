#!/usr/bin/env bash
# agent_1 Commit Message Hook
# 确保提交信息遵循 Conventional Commits 规范

COMMIT_MSG=$(cat "$1")

PATTERN="^(feat|fix|docs|style|refactor|test|chore|perf|security)(\(.+\))?: .+"

if ! echo "$COMMIT_MSG" | head -1 | grep -qE "$PATTERN"; then
  echo ""
  echo "  ✗ Invalid commit message format."
  echo "  Expected: <type>(<scope>): <subject>"
  echo ""
  echo "  Valid types: feat | fix | docs | style | refactor | test | chore | perf | security"
  echo "  Examples:"
  echo "    feat(mcp): add MCP Tasks Protocol support"
  echo "    fix(circuit-breaker): resolve state transition race"
  echo "    docs(readme): add installation guide"
  echo ""
  exit 1
fi

echo "  ✓ Commit message format OK"