{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022"],
    "outDir": "../dist-web",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "moduleResolution": "node16"
  },
  "include": ["./server.ts", "../src/**/*.ts"],
  "exclude": ["node_modules", "client", "../src/index.ts", "../src/cli/main.tsx"]
}