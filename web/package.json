{
  "name": "agent_1-web",
  "version": "1.0.0",
  "description": "agent_1 Web 端 - WebSocket 远程连接服务",
  "type": "module",
  "main": "../dist-web/web/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('../dist-web/web/client',{recursive:true});fs.cpSync('client','../dist-web/web/client',{recursive:true})\"",
    "start": "node ../dist-web/web/server.js",
    "dev": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('../dist-web/web/client',{recursive:true});fs.cpSync('client','../dist-web/web/client',{recursive:true})\" && node ../dist-web/web/server.js"
  },
  "dependencies": {
    "ws": "^8.16.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}