{
  "name": "agent_1",
  "version": "1.0.0",
  "description": "跨平台 AI 编程助手 - CLI / Desktop / Web 三端统一",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent_1": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "desktop:build": "cd desktop && npm run build",
    "desktop:dev": "cd desktop && npm run dev",
    "web:build": "cd web && npm run build",
    "web:start": "cd web && npm run start"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "husky": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}