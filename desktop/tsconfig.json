{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "moduleResolution": "node16",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../src/core/*"],
      "@types": ["../src/types/index"]
    }
  },
  "include": ["main/**/*", "preload/**/*", "renderer/**/*"],
  "exclude": ["node_modules", "dist"]
}