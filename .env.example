# agent_1 Environment Variables
# Copy this file to .env and fill in your values

# === API Keys ===
# At least one API key is required to use agent_1
# Keys are auto-detected from environment variables on first run
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# === Server Configuration ===
# WebSocket server settings (for web client)
AGENT_1_PORT=3099
AGENT_1_HOST=127.0.0.1

# === Project ===
# Default project directory (optional)
AGENT_1_PROJECT=

# === Security ===
# Sandbox mode: off | readonly | workspace | full
AGENT_1_SANDBOX_MODE=workspace

# === Display ===
# Disable ANSI color output
AGENT_1_NO_COLOR=

# === Debug ===
# Enable debug logging
AGENT1_DEBUG=false
